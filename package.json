{
  "name": "ip-sliding-window-limiter",
  "version": "1.0.0",
  "private": true,
  "description": "An exact, bounded, per-IP sliding-window rate limiter for Express.",
  "license": "MIT",
  "engines": {
    "node": "^22.23.5 || ^24.22.3"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test",
    "test:core": "npm run build && node --test tests/core.test.mjs",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=dist/src/**/*.js --test-coverage-branches=90",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "bench": "npm run build && node --expose-gc scripts/benchmark.mjs"
  },
  "dependencies": {
    "content-type": "^2.1.0",
    "express": "^5.3.0",
    "ipaddr.js": "^2.5.0",
    "raw-body": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
